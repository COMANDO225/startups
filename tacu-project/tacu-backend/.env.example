# Modelos. Crear la clave en https://aistudio.google.com
GEMINI_API_KEY=
OPENAI_API_KEY=

# Modelo de vision para leer cartas.
TACU_AI_MODELO_VISION=gemini-3.7-flash

# Cloudflare R2. Las dos ultimas son credenciales.
TACU_ALMACEN_TIPO=disco
R2_CUENTA=
R2_BUCKET_PUBLICO=
R2_BUCKET_PRIVADO=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Firma las URLs de las imagenes privadas: sin esto el servidor no arranca.
# Generarlo con: python3 -c 'import secrets;print(secrets.token_urlsafe(48))'
TACU_MEDIA_SECRETO=
